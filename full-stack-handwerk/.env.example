# Datenbankverbindung
# SQLite (Entwicklung): sqlite:///./pixelwise.db
# PostgreSQL (Produktion): postgresql://pixelwise:${DB_PASSWORD}@localhost/pixelwise
DATABASE_URL=sqlite:///./pixelwise.db

# Passwort für PostgreSQL-Nutzer (nur bei PostgreSQL relevant)
DB_PASSWORD=replace-me

# API-Key für geschützte Endpunkte
SECRET_API_KEY=replace-me

# Modell-Konfiguration
MODEL_PATH=models/digit_classifier_v1.pkl
MODEL_REPO=https://github.com/schutera/pixelwise-model.git
MODEL_VERSION=v1.0
